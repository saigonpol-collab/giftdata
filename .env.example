# ============================================================================
# TRADEINTEL GLOBAL – ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================
# IMPORTANT: Never commit real API keys, webhook secrets, or credentials to git.
# Copy this file to `.env.local` and configure only verified endpoints.
# When variables are omitted, the platform safely runs in MOCK / LOGGING MODE
# and clearly indicates integration readiness without fabricating responses.

# 1. Site & Canonical Configuration
NEXT_PUBLIC_SITE_URL=https://data.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=vi
PORT=3000

# 2. Official Contact & Zalo Integration (Leave empty until official account is verified)
NEXT_PUBLIC_OFFICIAL_ZALO_URL=
NEXT_PUBLIC_OFFICIAL_PHONE=
NEXT_PUBLIC_OFFICIAL_EMAIL=contact@tradeintel.global

# 3. Lead Management & CRM Webhook Integrations (Server-side only)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
GOOGLE_SHEETS_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_URL=

# 4. Analytics & Conversion Tracking (Optional - Activated only when configured)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# 5. Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=600
